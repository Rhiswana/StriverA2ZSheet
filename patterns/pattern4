//Java


class Solution {
    public void pattern4(int n) {
      for(int i=1;i<=n;i++){
        //columns
        for(int j=1;j<=i;j++){
            System.out.print(i);
        }
        System.out.println();
     }
    }
}


//c++

class Solution {
public:
    void pattern4(int n) {

        for (int i = 1; i <= n; i++) {

            // columns
            for (int j = 1; j <= i; j++) {
                cout << i;
            }

            cout << endl;
        }
    }
};


//Python

class Solution:
    def pattern4(self, n):

        for i in range(1, n + 1):

            # columns
            for j in range(1, i + 1):
                print(i, end="")

            print()


//Javascript


class Solution {
    pattern4(n) {

        for (let i = 1; i <= n; i++) {

            // columns
            for (let j = 1; j <= i; j++) {
                process.stdout.write(String(i));
            }

            console.log();
        }
    }
}