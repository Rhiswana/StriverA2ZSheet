//Java

class Solution {
    public void pattern2(int n) {
       //rows
       for(int i=1;i<=n;i++){
        //col
        for(int j=1;j<=i;j++){
            System.out.print("*");

        }
        System.out.println();
       }
        }
    }

    //c++

    class Solution {
public:
    void pattern2(int n) {

        // rows
        for (int i = 1; i <= n; i++) {

            // col
            for (int j = 1; j <= i; j++) {
                cout << "*";
            }

            cout << endl;
        }
    }
};


