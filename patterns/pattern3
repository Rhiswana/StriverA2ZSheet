//Java

class Solution {
    public void pattern3(int n) {
     //rows
     for(int i=1;i<=n;i++){
        //columns
        for(int j=1;j<=i;j++){
            System.out.print(j);
        }
        System.out.println();
     }
    }
}

//c++

class Solution {
public:
    void pattern3(int n) {

        // rows
        for (int i = 1; i <= n; i++) {

            // columns
            for (int j = 1; j <= i; j++) {
                cout << j;
            }

            cout << endl;
        }
    }
};


//Python

class Solution:
    def pattern3(self, n):

        # rows
        for i in range(1, n + 1):

            # columns
            for j in range(1, i + 1):
                print(j, end="")

            print()


//Javascript
 

class Solution {
    pattern3(n) {

        // rows
        for (let i = 1; i <= n; i++) {

            // columns
            for (let j = 1; j <= i; j++) {
                process.stdout.write(String(j));
            }

            console.log();
        }
    }
}