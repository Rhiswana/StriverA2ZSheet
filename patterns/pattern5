//Java

class Solution {
    public void pattern5(int n) { 
    //rows
    for(int i=1;i<=n;i++){
        //columns
        for(int j=1;j<=n-i+1;j++){
            System.out.print("*");
        }
        System.out.println();
    }

    }
}

//c++



class Solution {
public:
    void pattern5(int n) {

        // rows
        for (int i = 1; i <= n; i++) {

            // columns
            for (int j = 1; j <= n - i + 1; j++) {
                cout << "*";
            }

            cout << endl;
        }
    }
};


