//Java


class Solution {
    public void pattern6(int n) {
       for(int i=1;i<=n;i++){
        //columns
        for(int j=1;j<=n-i+1;j++){
            System.out.print(j);
        }
        System.out.println();
    }

    }
}


//c++

class Solution {
public:
    void pattern6(int n) {

        for (int i = 1; i <= n; i++) {

            // columns
            for (int j = 1; j <= n - i + 1; j++) {
                cout << j;
            }

            cout << endl;
        }
    }
};


