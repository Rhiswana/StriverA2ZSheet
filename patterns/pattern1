//Java


class Solution {
    public void pattern1(int n) {
   
      for(int i=1;i<=n;i++){
        for(int j=1;j<=n;j++){
            System.out.print("*");
        }
        System.out.println();
      }

        }

    }

    //c++

    class Solution {
public:
    void pattern1(int n) {

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                cout << "*";
            }
            cout << endl;
        }
    }
};

//python

class Solution:
    def pattern1(self, n):

        for i in range(1, n + 1):
            for j in range(1, n + 1):
                print("*", end="")
            print()

        
//JavaScript


class Solution {
    pattern1(n) {

